<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      主题基线：light-parchment。状态栏 / 导航栏的浅色图标属性在 API 23 / 27 才存在，
      放在默认 values 里对 minSdk 21 是无效声明，已迁到 values-v23 / values-v27 覆盖。
    -->
    <style name="Theme.Poetry.Base" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_pressed</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <!-- 状态栏 / 导航栏跟宣纸底同色，别在顶部留一条白边 -->
        <item name="android:windowBackground">#F6F1E7</item>
        <item name="android:statusBarColor">#F6F1E7</item>
        <item name="android:navigationBarColor">#F6F1E7</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Poetry.Sheet</item>
    </style>

    <style name="Theme.Poetry" parent="Theme.Poetry.Base" />

    <!-- 单字释义弹层：顶部 16dp 圆角，其余沿用默认 -->
    <style name="Theme.Poetry.Sheet" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Poetry.BottomSheet</item>
    </style>

    <style name="Poetry.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/Poetry.BottomSheetShape</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="Poetry.BottomSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- 底部导航选中项的活动指示：主色浅底胶囊 -->
    <style name="Poetry.NavIndicator" parent="">
        <item name="android:width">56dp</item>
        <item name="android:height">30dp</item>
        <item name="marginHorizontal">8dp</item>
        <item name="android:color">@color/accent_tint</item>
        <item name="shapeAppearanceOverlay">@style/Poetry.PillShape</item>
    </style>

    <style name="Poetry.PillShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 文字阶梯：对齐客户端 12 / 13 / 14 / 16 / 19 / 24 与 400/500 两档字重 -->
    <style name="Text.AppTitle" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Section" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- 顶栏标题：16sp / 500 / 标题负字距，别再在布局里手抄 fontFamily + letterSpacing -->
    <style name="Text.BarTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Item" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.DailyTitle" parent="">
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">7dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Poem" parent="">
        <item name="android:textSize">19sp</item>
        <item name="android:lineSpacingMultiplier">1.9</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 首页日读正文：16sp 档，行距与 Text.Poem 同源思路 -->
    <style name="Text.DailyPoem" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.8</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Input" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!--
      Meta 装的是日期、篇数、作者数这类要读的信息，用 text_muted（白底约 5.0:1）；
      纯占位提示继续用更浅的 text_tertiary。
    -->
    <style name="Text.Meta" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Text.Excerpt" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- 弹层里的拼音：19sp 档 + 强调色 -->
    <style name="Text.RubyHead" parent="">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <!--
      字典头字：单个汉字是这张卡片要展示的内容本身，不是界面标题，
      所以不套 12/13/14/16/19/24 的 UI 阶梯；24sp 时它只比正文大 1.5 倍，压不住释义。
    -->
    <style name="Text.ZiHead" parent="">
        <item name="android:textSize">36sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Poetry.Tag" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- 扁平白卡 + 1px 细边的次级动作，不用渐变 -->
    <style name="Poetry.Action" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:background">@drawable/bg_card_press</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
</resources>
