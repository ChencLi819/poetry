# 统一换行符，避免 Windows 检出时整文件 diff
* text=auto eol=lf

# 二进制资源不做行尾转换、不计入语言统计
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.apk  binary
*.aab  binary
*.keystore binary
*.jks  binary
*.db   binary
*.ttf  binary
*.otf  binary

# 前端资源
*.html text
*.css  text
*.js   text

# 语料与脚本
*.py   text
*.json text
*.md   text

# 大体积语料在 GitHub 上按二进制处理，避免 diff 卡死
*.jsonl binary

# 构建产物不参与语言统计
android/app/build/** linguist-vendored
android/build/**     linguist-vendored
_tmp/**              linguist-vendored
